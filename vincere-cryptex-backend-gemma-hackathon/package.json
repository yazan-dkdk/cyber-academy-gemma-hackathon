{
  "name": "cyber-academy-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "lint": "eslint \"src/**/*.ts\" \"prisma/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\" --max-warnings=0",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:integration": "node --env-file=.env.integration --import tsx scripts/integration/run-tests.ts",
    "test:ai-tutor-protection": "tsx --test src/ai-tutor/ai-tutor-protection.spec.ts src/config/environment.spec.ts src/redis/redis.service.spec.ts",
    "integration:up": "docker compose -f docker-compose.integration.yml up --detach --wait",
    "integration:migrate": "node --env-file=.env.integration --import tsx scripts/integration/reset-database.ts",
    "integration:down": "docker compose -f docker-compose.integration.yml down",
    "integration:clean": "docker compose -f docker-compose.integration.yml down --volumes --remove-orphans",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "prisma:generate": "node node_modules/prisma/build/index.js generate",
    "prisma:migrate:dev": "node node_modules/prisma/build/index.js migrate dev",
    "prisma:migrate:deploy": "node node_modules/prisma/build/index.js migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^10.0.1",
    "@fastify/helmet": "^13.1.0",
    "@nestjs/common": "^11.1.29",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.29",
    "@nestjs/platform-fastify": "^11.1.29",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "nodemailer": "^8.0.11",
    "otplib": "^12.0.1",
    "redis": "^4.7.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "eslint": "^9.39.5",
    "prisma": "^6.19.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.0"
  }
}
